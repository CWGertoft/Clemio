# Web / Supabase. Use the publishable key in the browser, never a service role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Kept for compatibility with older Supabase projects:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The FastAPI service runs separately from the Next.js application.
AI_SERVICE_URL=http://localhost:8000

# FastAPI only
AI_PROVIDER=mock
OPENAI_API_KEY=
